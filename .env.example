# No secrets needed. Docker Compose supplies the API address at build time.
MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:8000
# Optional direct browser API address (normally leave blank and use Next rewrites).
NEXT_PUBLIC_API_URL=
# Reserved for a future optional narrative provider. Never shipped to the browser.
NARRATIVE_PROVIDER=local
OPENAI_API_KEY=
